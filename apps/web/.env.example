# Optional. Defaults are the public development endpoints.
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
VITE_OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Satellite stays disabled until a tile template is set.
# VITE_SATELLITE_TILE_URL=https://example.com/tiles/{z}/{x}/{y}.png

# SUMO worker from docker compose. The map stays on "No active simulation" until this answers.
# VITE_SIMULATION_URL=http://127.0.0.1:8081
